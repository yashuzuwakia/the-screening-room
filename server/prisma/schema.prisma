generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         String   @default("user")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ratings              Rating[]
  watchlist            WatchlistItem[]
  posts                CommunityPost[]
  replies              CommunityReply[]
  likes                CommunityLike[]
  recommendationSessions RecommendationSession[]

  @@map("users")
}

model Movie {
  id              String   @id @default(cuid())
  tmdbId          Int      @unique @map("tmdb_id")
  title           String
  overview        String   @default("")
  posterPath      String?  @map("poster_path")
  backdropPath    String?  @map("backdrop_path")
  releaseDate     String?  @map("release_date")
  runtime         Int?
  voteAverage     Float?   @map("vote_average")
  voteCount       Int?     @map("vote_count")
  popularity      Float?
  genreIds        Int[]    @default([]) @map("genre_ids")
  communityAvg    Float?   @map("community_avg")
  communityCount  Int      @default(0) @map("community_count")
  syncedAt        DateTime @default(now()) @map("synced_at")

  ratings   Rating[]
  watchlist WatchlistItem[]
  posts     CommunityPost[]

  @@map("movies")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  movieId   String   @map("movie_id")
  score     Float
  review    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("ratings")
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  movieId   String   @map("movie_id")
  addedAt   DateTime @default(now()) @map("added_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("watchlist_items")
}

model CommunityPost {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  movieId   String?   @map("movie_id")
  title     String
  body      String
  type      String    @default("discussion")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie?            @relation(fields: [movieId], references: [id], onDelete: SetNull)
  replies CommunityReply[]
  likes   CommunityLike[]

  @@index([createdAt(sort: Desc)])
  @@map("community_posts")
}

model CommunityReply {
  id        String    @id @default(cuid())
  postId    String    @map("post_id")
  userId    String    @map("user_id")
  body      String
  parentId  String?   @map("parent_id")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("community_replies")
}

model CommunityLike {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("community_likes")
}

model RecommendationSession {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  mood      String
  genres    Int[]
  platforms String[]
  runtime   String
  results   Json?
  source    String?
  elapsedMs Int?     @map("elapsed_ms")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("recommendation_sessions")
}
