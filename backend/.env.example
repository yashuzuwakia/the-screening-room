PORT=5000
DATABASE_URL=postgresql://moviematch:moviematch@localhost:5432/moviematch
JWT_SECRET=change-me-to-a-long-random-string
TMDB_API_KEY=
WATCH_REGION=US
CLIENT_ORIGIN=http://localhost:5173
# Optional: GIF search in community comments (https://developers.giphy.com/)
GIPHY_API_KEY=
# Optional: absolute URLs for uploaded media when API is behind another host
PUBLIC_API_ORIGIN=
# Optional: Gmail (or other SMTP) for password reset emails — use a Google App Password for Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# When SMTP is empty, dev uses Ethereal test mail (preview link in UI). Set false to disable.
# USE_ETHEREAL_EMAIL=true
PASSWORD_RESET_TTL_MINUTES=60
# In production without SMTP, set false so reset links are not returned in API JSON
# PASSWORD_RESET_EXPOSE_LINK=false
