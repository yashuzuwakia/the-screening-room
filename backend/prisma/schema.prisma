generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  avatarUrl    String?  @map("avatar_url")
  watchRegion  String   @default("US") @map("watch_region")
  role         String   @default("user")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ratings              Rating[]
  watchlist            WatchlistItem[]
  posts                CommunityPost[]
  replies              CommunityReply[]
  likes                CommunityLike[]
  recommendationSessions RecommendationSession[]
  discoverPins           DiscoverPin[]
  discoverExclusions     DiscoverExclusion[]
  passwordResetTokens    PasswordResetToken[]
  seenMovies             UserSeenMovie[]

  @@map("users")
}

/// Titles the user passed on or marked as already watched (synced across devices).
model UserSeenMovie {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tmdbId    Int      @map("tmdb_id")
  source    String   @default("watched")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@index([userId])
  @@map("user_seen_movies")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

/// Admin-pinned movies merged on top of TMDB Discover lists.
model DiscoverPin {
  id         String   @id @default(cuid())
  region     String
  listKind   String   @map("list_kind") // "regional" | "genre"
  genreId    Int?     @map("genre_id")
  tmdbId     Int      @map("tmdb_id")
  position   Int      @default(1)
  overrides  Json?
  active     Boolean  @default(true)
  createdById String? @map("created_by_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([region, listKind, genreId, active])
  @@map("discover_pins")
}

/// Admin-hidden movies removed from TMDB discover lists for a country/tab.
model DiscoverExclusion {
  id          String   @id @default(cuid())
  region      String
  listKind    String   @map("list_kind")
  genreId     Int?     @map("genre_id")
  tmdbId      Int      @map("tmdb_id")
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([region, listKind, genreId, tmdbId])
  @@index([region, listKind, genreId, active])
  @@map("discover_exclusions")
}

model Movie {
  id              String   @id @default(cuid())
  tmdbId          Int      @unique @map("tmdb_id")
  title           String
  overview        String   @default("")
  posterPath      String?  @map("poster_path")
  backdropPath    String?  @map("backdrop_path")
  releaseDate     String?  @map("release_date")
  runtime         Int?
  voteAverage     Float?   @map("vote_average")
  voteCount       Int?     @map("vote_count")
  popularity      Float?
  genreIds        Int[]    @default([]) @map("genre_ids")
  communityAvg    Float?   @map("community_avg")
  communityCount  Int      @default(0) @map("community_count")
  syncedAt        DateTime @default(now()) @map("synced_at")

  ratings   Rating[]
  watchlist WatchlistItem[]
  posts     CommunityPost[]

  @@map("movies")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  movieId   String   @map("movie_id")
  score     Float
  review    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("ratings")
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  movieId   String   @map("movie_id")
  addedAt   DateTime @default(now()) @map("added_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("watchlist_items")
}

model CommunityPost {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  movieId   String?   @map("movie_id")
  title     String
  body      String
  mediaUrls Json      @default("[]") @map("media_urls")
  type      String    @default("discussion")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie?            @relation(fields: [movieId], references: [id], onDelete: SetNull)
  replies CommunityReply[]
  likes   CommunityLike[]

  @@index([createdAt(sort: Desc)])
  @@map("community_posts")
}

model CommunityReply {
  id        String    @id @default(cuid())
  postId    String    @map("post_id")
  userId    String    @map("user_id")
  body      String
  mediaUrls Json      @default("[]") @map("media_urls")
  parentId  String?   @map("parent_id")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("community_replies")
}

model CommunityLike {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("community_likes")
}

model RecommendationSession {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  mood      String
  genres    Int[]
  platforms String[]
  runtime   String
  results   Json?
  source    String?
  elapsedMs Int?     @map("elapsed_ms")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("recommendation_sessions")
}
