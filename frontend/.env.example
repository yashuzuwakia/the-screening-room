# Copy to .env.local and fill in. Without a key the app runs on its built-in offline catalog.
# Get a free key at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=
# Region used for streaming availability (ISO 3166-1 code)
VITE_WATCH_REGION=US

# Use the Movie Match API (Postgres + lazy TMDB cache) instead of calling TMDB from the browser
VITE_USE_API=true
# Leave empty in dev — Vite proxies /api to localhost:5000
VITE_API_URL=
